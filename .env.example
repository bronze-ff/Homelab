# ===== Configuração global do Homelab (TEMPLATE) =====
# Copie este arquivo para ".env" e preencha os valores.
#   PowerShell:  Copy-Item .env.example .env
#
# Dica para gerar segredos hex de 64 caracteres (Homarr) no PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })

# Fuso horário
TZ=America/Sao_Paulo

# UID/GID usados pelos containers linuxserver.io
# (no Docker Desktop/WSL2 pode deixar 1000/1000)
PUID=1000
PGID=1000

# Caminho da MÍDIA no host (HD/SSD de dados).
# Tudo (torrents + biblioteca) fica sob esta pasta para permitir HARDLINK.
# No Windows com Docker Desktop use barra normal "/".
MEDIA_PATH=D:/Media/data

# Caminho onde fica o appdata (config) de cada serviço.
# "./config" = subpasta config dentro do repositório.
CONFIG_PATH=./config

# Segredo de criptografia do Homarr (dashboard) — hex de 64 caracteres.
HOMARR_SECRET=COLE_UM_HEX_DE_64_CARACTERES

# Token de administração do Vaultwarden (acesse /admin com ele)
VAULTWARDEN_ADMIN_TOKEN=COLE_UM_TOKEN_ALEATORIO
# URL HTTPS do Vaultwarden (via Tailscale Serve)
VAULTWARDEN_DOMAIN=https://SEU-HOST.tailXXXX.ts.net

# Nextcloud (banco MariaDB)
NEXTCLOUD_DB_ROOT_PASSWORD=TROQUE_ESTA_SENHA
NEXTCLOUD_DB_PASSWORD=TROQUE_ESTA_SENHA

# Immich (fotos) - senha do Postgres (somente alfanumerico)
IMMICH_DB_USER=postgres
IMMICH_DB_PASSWORD=TROQUE_ESTA_SENHA_ALFANUMERICA
IMMICH_UPLOAD_LOCATION=D:/Media/data/immich

# Nextcloud - admin criado automaticamente no 1o boot (troque a senha depois)
NEXTCLOUD_ADMIN_PASSWORD=TROQUE_ESTA_SENHA

# Senha que criptografa o arquivo de backup do Vaultwarden (camada extra AES-256).
# Guarde-a tambem fora do repo - sem ela nao da pra restaurar o backup.
VAULTWARDEN_BACKUP_PASSWORD=GERE_UMA_SENHA_FORTE
