# ===== Homelab no PC de casa (WSL2 + Docker) — TEMPLATE =====
# Use com o docker-compose.wsl.yml. No WSL: cp .env.wsl.example .env  (o .env nunca vai pro Git)

# Compose usa este arquivo sem precisar de -f
COMPOSE_FILE=docker-compose.wsl.yml
TZ=America/Sao_Paulo
PUID=1000
PGID=1000

# Mídia no HD D: (filmes/ series/ animes/ torrents/ — mesmo disco, hardlink)
MEDIA_PATH=/mnt/d/Homelab/media
# Configs dentro do disco virtual do WSL (ext4)
CONFIG_PATH=/home/SEU_USUARIO/homelab-config

# Homarr (opcional, perfil "extras"):  openssl rand -hex 32
HOMARR_SECRET=COLE_UM_HEX_DE_64_CARACTERES

# openGym: passkeys exigem HTTPS e ficam presas ao nome exato do host
OPENGYM_RP_ID=SEU-HOST.tailXXXX.ts.net
OPENGYM_ORIGIN=https://SEU-HOST.tailXXXX.ts.net:8443
OPENGYM_INVITE_ONLY=0

# Gerada no primeiro setup (senha da Web UI do qBittorrent)
# QBIT_PASSWORD=

# ntfy (avisos no celular), Vaultwarden e chaves do Unpackerr
NTFY_BASE_URL=https://SEU-HOST.tailXXXX.ts.net:10000
NTFY_TOPIC_SISTEMA=casa-sistema
VAULTWARDEN_DOMAIN=https://SEU-HOST.tailXXXX.ts.net/vault
VAULTWARDEN_ADMIN_TOKEN=GERE_UM_TOKEN_ALEATORIO
VAULTWARDEN_SIGNUPS=true
SONARR_API_KEY=
RADARR_API_KEY=
# Frigate lê o RTSP direto do DVR (preenchido a partir do go2rtc.yaml, neste PC)
FRIGATE_DVR_USER=
FRIGATE_DVR_PASS=
FRIGATE_DVR_HOST=IP_DO_DVR:554
