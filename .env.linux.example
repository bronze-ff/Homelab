# ===== Homelab Debian/Linux — configuração global (TEMPLATE) =====
# Use com o docker-compose.linux.yml. Copie para ".env" na mesma pasta e preencha:
#   cp .env.linux.example .env
# Subir a stack:
#   docker compose -f docker-compose.linux.yml up -d
#
# (No servidor atual este arquivo vive em /home/filippe/streaming/.env)

# Fuso horário
TZ=America/Sao_Paulo

# UID/GID do dono dos arquivos. No Debian o 1º usuário normalmente é 1000/1000.
#   confira com:  id -u   e   id -g
PUID=1000
PGID=1000

# Mídia: biblioteca + downloads no MESMO filesystem (permite HARDLINK).
# Estrutura esperada dentro desta pasta:  filmes/  series/  animes/  downloads/  torrents/
MEDIA_PATH=/home/SEU_USUARIO/media

# Appdata (config) de cada serviço — /home/SEU_USUARIO/config/<app>
CONFIG_PATH=/home/SEU_USUARIO/config

# Segredo de criptografia do Homarr (hex de 64 chars). Gere com:
#   openssl rand -hex 32
HOMARR_SECRET=COLE_UM_HEX_DE_64_CARACTERES

# ---- Vaultwarden ----
# ADMIN_TOKEN: token da página /admin. Gere um aleatório (alfanumérico p/ não quebrar o .env):
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48; echo
VAULTWARDEN_ADMIN_TOKEN=COLE_UM_TOKEN_ALEATORIO
# DOMAIN: URL de acesso. Ideal via Tailscale HTTPS (precisa de 'tailscale serve'):
#   https://SEU-HOST.tailXXXX.ts.net
# Sem HTTPS, os apps Bitwarden (celular/desktop/extensão) funcionam em http://IP_TAILSCALE:8222;
# só o cofre WEB no navegador exige HTTPS (contexto seguro / WebCrypto).
VAULTWARDEN_DOMAIN=https://SEU-HOST.tailXXXX.ts.net
# Senha que CRIPTOGRAFA o backup do cofre (se usar ttionya/vaultwarden-backup).
# Guarde-a também FORA do repo — sem ela não dá pra restaurar o backup.
VAULTWARDEN_BACKUP_PASSWORD=GERE_UMA_SENHA_FORTE
